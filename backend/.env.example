PORT=5001
# Optional: if unset or unreachable, the app falls back to an in-memory
# contact-message store automatically (no DB setup needed to run locally).
MONGODB_URI=mongodb://127.0.0.1:27017/sanaullah_portfolio
CLIENT_ORIGIN=http://localhost:5173

# Required to use the admin panel (adding/deleting posts, reading the
# contact inbox at /?admin=1 on the frontend). Pick any long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string
